{
  "schema_version": 1,
  "policy": {
    "resolution": "exact-model-id",
    "automatic_fallback": false,
    "normal_run_discovery": false,
    "forbidden_discovery_paths": [
      "/videos/models",
      "/gradio_api/info",
      "/config"
    ]
  },
  "models": {
    "alibaba/wan-2.2": {
      "adapter": "eliza-segmind",
      "transport": "eliza-synchronous-binary",
      "default_base_url": "https://api.eliza.yandex.net/segmind/v1",
      "capacity": 1,
      "gateway": "eliza",
      "provider_key": "segmind",
      "provider_model_id": "segmind/wan-2.2-i2v-flash",
      "paths": {
        "submit": "/wan-2.2-i2v-flash"
      },
      "submit_payload": {
        "fields": [
          "image",
          "prompt",
          "negative_prompt",
          "resolution",
          "prompt_extend",
          "watermark",
          "seed"
        ],
        "fixed": {
          "resolution": "720p",
          "prompt_extend": false,
          "watermark": false,
          "seed": 220214
        }
      },
      "request_headers": {
        "accept": "video/mp4, application/octet-stream",
        "x_retries": "1",
        "x_include_cost": "true",
        "optional_pool_env": [
          "ELIZA_POOL",
          "YA_POOL"
        ]
      },
      "response": {
        "content_types": [
          "video/mp4",
          "application/octet-stream"
        ],
        "request_id_header": "X-Segmind-Request-Id",
        "cost_header": "X-Response-Cost"
      },
      "synchronous": true,
      "automatic_retry": false
    },
    "alibaba/wan-2.7": {
      "adapter": "eliza-openrouter",
      "transport": "eliza-video-jobs",
      "default_base_url": "https://api.eliza.yandex.net/openrouter/v1",
      "capacity": 3,
      "provider_key": "atlas-cloud",
      "paths": {
        "submit": "/videos",
        "status_template": "/videos/{job_id}",
        "content_template": "/videos/{job_id}/content?index=0"
      }
    },
    "google/veo-3.1-lite": {
      "adapter": "eliza-openrouter",
      "transport": "eliza-video-jobs",
      "default_base_url": "https://api.eliza.yandex.net/openrouter/v1",
      "capacity": 3,
      "provider_key": "google-vertex",
      "paths": {
        "submit": "/videos",
        "status_template": "/videos/{job_id}",
        "content_template": "/videos/{job_id}/content?index=0"
      }
    }
  }
}
